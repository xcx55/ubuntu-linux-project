#include "threadpool.hpp"
#include <functional>
using namespace _THREADPOOL_SPACE;
using task_t = std::function<void()>;
// using task_t = std::function<int(int, int)>;
int main()
{
    threadpool<task_t> qp;
    int g = 10;
    qp.Enqueue([&g]() -> void
               { std::cout<<"应该超过了"; });
    while(true){}
    return 0;
}